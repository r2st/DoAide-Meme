[Unit]
Description=DoAide Meme Web Frontend
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/doaide-meme
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3052
Environment=HOST=172.18.0.1
EnvironmentFile=/opt/doaide-meme/.env

[Install]
WantedBy=multi-user.target
